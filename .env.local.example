# Postgres connection string (Neon, provisioned via the Vercel Marketplace).
# Leave unset in local development: the app then uses an embedded database
# (PGlite, stored in .pglite/), applies migrations and seeds the launch data.
# In production this is REQUIRED; the app refuses to start without it.
DATABASE_URL=

# Vercel Blob read/write token for product, brand and logo images. Only needed
# to upload images from the admin area.
BLOB_READ_WRITE_TOKEN=

# Long random string used to sign the admin session cookie (pepclub_admin).
# Required in production; in development an insecure built-in fallback is used.
ADMIN_SESSION_SECRET=

# Used only by `npm run admin:create` to create the first admin without a prompt.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Resend API key used to send new-order notification emails.
# If left unset in development, lib/order-email.ts logs the email to the
# server console instead of sending it.
RESEND_API_KEY=

# Fallback inbox for new-order emails when no store email is set in admin Settings.
ORDER_NOTIFICATION_EMAIL=orders@example.com

# Optional overrides for the database-backed rate limits (defaults shown).
# ORDER_LIMIT_PER_IP=5             # orders per 10 minutes
# LOGIN_LIMIT_PER_IP=10            # admin sign-in attempts per 15 minutes
# (Per-account lockout is fixed: 5 failed sign-ins lock the account for 15 minutes.)
# SUBMIT_LIMIT_PER_IP=5            # feedback / data-request submissions per 10 minutes

# Extra hosts trusted by the Server Action CSRF origin check (comma-separated,
# host only, e.g. www.example.com). Needed only if a proxy/CDN rewrites Host.
# ALLOWED_ORIGINS=
