# Resend API key used to send quote-request notification emails.
# If left unset in development, lib/email.ts logs the request to the
# server console instead of sending — useful for local testing without
# a real Resend account.
RESEND_API_KEY=

# The business inbox that receives quote-request notification emails.
ORDER_NOTIFICATION_EMAIL=orders@example.com

# Phone verification by one-time code (SMS), via Twilio Verify.
# In development, leave the three TWILIO_* variables unset: the code is
# printed to the server console and "000000" is accepted. This fallback is
# disabled when NODE_ENV=production (including Vercel previews): there, all
# four variables below are required or phone verification fails closed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Long random string used to sign the "phone verified" token.
PHONE_TOKEN_SECRET=

# Optional overrides for the OTP rate limits (defaults shown).
# OTP_SEND_LIMIT_PER_IP=3          # per 10 minutes
# OTP_SEND_LIMIT_PER_PHONE=3       # per hour
# OTP_CHECK_LIMIT_PER_IP=10        # per 10 minutes
